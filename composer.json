{
    "name": "nextvikas/laravel-google-authenticator",
    "description": "A highly secure, dependency-free package to add Google Two-Factor Authentication (2FA) to Laravel applications.",
    "keywords": [
        "laravel",
        "google",
        "authenticator",
        "google2fa",
        "2fa",
        "two-factor",
        "mfa",
        "otp",
        "security",
        "2-step-verification",
        "dependency-free"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vikas Pandey",
            "email": "svikas.pandey@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nextvikas/laravel-google-authenticator",
    "support": {
        "source": "https://github.com/nextvikas/laravel-google-authenticator",
        "issues": "https://github.com/nextvikas/laravel-google-authenticator/issues"
    },
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3",
        "laravel/framework": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nextvikas\\Authenticator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nextvikas\\Authenticator\\AuthenticatorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
